# Expo only exposes EXPO_PUBLIC_* vars to the app bundle.

# Backend base URL. Use the ngrok/Expo tunnel URL when testing on a phone
# (see ngrok_setup.md); localhost only works in a simulator on the same machine.
EXPO_PUBLIC_API_URL="http://localhost:8000"

# Mapbox public access token (starts with pk.) from https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN="pk.your-mapbox-public-token"

# Supabase project URL and the ANON/publishable key (never the service-role key:
# anything here ends up in the app bundle). Required for multiplayer Realtime and
# the invite friend lookup; without them the match room falls back to polling.
EXPO_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Mapbox secret download token (starts with sk., needs the DOWNLOADS:READ scope).
# Only required to build a native dev client / EAS build with @rnmapbox/maps.
MAPBOX_DOWNLOAD_TOKEN="sk.your-mapbox-download-token"
